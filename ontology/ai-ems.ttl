aiems:minimumPowerKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:maximumPowerKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:importLimitKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:exportLimitKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:requestedEnergyKwh a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:requestedDepartureSoc a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:departureAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
aiems:arrivalAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
aiems:sessionStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
aiems:assetStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
aiems:ratedPowerKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:connectorStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
aiems:stateOfCharge a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:energyCapacityKwh a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:energyReserveKwh a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:ambientTemperatureC a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:relativeHumidityPercent a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:windSpeedMPerS a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:windDirectionDeg a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:precipitationMmPerHour a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:cloudCoverFraction a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:globalHorizontalIrradianceWPerM2 a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:directNormalIrradianceWPerM2 a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:diffuseHorizontalIrradianceWPerM2 a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:pvACPowerKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:pvDCPowerKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aiems:availablePVPowerKw a owl:DatatypeProperty ; rdfs:range xsd:decimal .
