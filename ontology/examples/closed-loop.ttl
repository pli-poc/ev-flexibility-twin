  aiems:usesAssessment ex:assessment-001 ; aiems:hasEventResponse ex:response-001 ;
  aiems:basedOn ex:pv-observation, ex:building-load-observation, ex:price-interval-001, ex:weather-temperature, ex:weather-forecast, ex:battery-observation, ex:grid-observation, ex:evse-observation ;
