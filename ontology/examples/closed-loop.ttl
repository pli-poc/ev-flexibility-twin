  aiems:faultDescription "Connector reports elevated temperature; charging remains available at reduced power." ;
  aiems:observedAt "2026-09-30T08:50:00Z"^^xsd:dateTime ; aiems:recordedAt "2026-09-30T08:50:01Z"^^xsd:dateTime ;
  aiems:dataQuality "good" ; aiems:providedBy ex:source-charger .
