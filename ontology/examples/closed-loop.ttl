@prefix aiems: <https://w3id.org/ev-energy-twin/ai-ems#> .
@prefix ex: <https://example.org/ai-ems/demo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:site a aiems:Site ; aiems:identifier "site-demo" ;
  aiems:hasAsset ex:grid, ex:pv-array, ex:battery, ex:building-load, ex:grid-meter, ex:evse-01 ;
  aiems:hasLocalProtectionState ex:protection-state .
ex:grid a aiems:GridConnection ; aiems:identifier "grid-demo" ; aiems:importLimitKw 90.0 ; aiems:exportLimitKw 45.0 ; aiems:siteConnectionState "connected" .
ex:pv-array a aiems:PVArray ; aiems:identifier "pv-array-01" ; aiems:ratedPowerKw 40.0 .
ex:battery a aiems:StationaryBattery ; aiems:identifier "battery-01" ; aiems:ratedPowerKw 30.0 ; aiems:energyCapacityKwh 60.0 ; aiems:energyReserveKwh 10.0 .
ex:building-load a aiems:ControllableLoad ; aiems:identifier "building-load-01" ; aiems:hasOperatingSchedule ex:building-schedule .
ex:building-schedule a aiems:OperatingSchedule ; aiems:scheduleName "weekday-comfort-hours" ;
  aiems:validFrom "2026-09-30T06:00:00Z"^^xsd:dateTime ; aiems:validUntil "2026-09-30T20:00:00Z"^^xsd:dateTime .
ex:comfort-constraint a aiems:ComfortConstraint ; aiems:minimumComfortValue 20.0 ; aiems:maximumComfortValue 24.0 ; aiems:unit "Cel" .
ex:grid-meter a aiems:GridMeter ; aiems:identifier "site-meter-01" .
ex:protection-state a aiems:SiteProtectionState ; aiems:localProtectionMode "normal" ; aiems:observedAt "2026-09-30T08:55:00Z"^^xsd:dateTime .
ex:evse-01 a aiems:EVSE ; aiems:identifier "evse-01" ; aiems:connectedTo ex:grid ; aiems:ratedPowerKw 11.0 ; aiems:assetStatus "available" ;
  aiems:hasConnector ex:connector-01 ; aiems:evseMaxCurrentA 16.0 ; aiems:evseVoltageV 400.0 ; aiems:evsePhaseCount 3 .
ex:connector-01 a aiems:Connector ; aiems:identifier "evse-01-connector-1" ; aiems:connectorFormat "IEC-62196-Type-2" ; aiems:connectorStatus "available" .
ex:smart-charging-capability a aiems:CapabilityDeclaration ; aiems:capabilityName "smart-charging-power-limit" ; aiems:capabilityStatus "supported" ; aiems:observedAt "2026-09-30T08:50:00Z"^^xsd:dateTime .
ex:evse-01 aiems:declaresCapability ex:smart-charging-capability .
ex:service-requirement-001 a aiems:CustomerServiceRequirement ; aiems:minimumDepartureEnergyKwh 18.0 ; aiems:departureAt "2026-09-30T11:00:00Z"^^xsd:dateTime ; aiems:priorityValue 2 .
ex:consent-001 a aiems:ConsentPolicy ; aiems:consentStatus "granted" .
ex:vehicle-001 a aiems:Vehicle ; aiems:identifier "vehicle-pseudonym-001" ; aiems:energyCapacityKwh 60.0 ; aiems:vehicleMaxChargeKw 11.0 .
ex:source-openadr a aiems:DataSource ; aiems:identifier "openadr-simulator" .
ex:source-charger a aiems:DataSource ; aiems:identifier "ocpp-simulator" .
ex:source-meter a aiems:DataSource ; aiems:identifier "meter-simulator" .
ex:source-market a aiems:DataSource ; aiems:identifier "market-simulator" .
ex:source-weather a aiems:DataSource ; aiems:identifier "weather-simulator" .
ex:source-battery a aiems:DataSource ; aiems:identifier "battery-simulator" .
ex:source-building a aiems:DataSource ; aiems:identifier "building-controller-simulator" .
ex:sensor-weather a aiems:Sensor ; aiems:identifier "weather-station-01" .
ex:location-site a aiems:SpatialLocation ; aiems:identifier "site-demo-location" ; aiems:latitude 52.09 ; aiems:longitude 5.12 .
ex:standard-ocpp a aiems:StandardReference ;
  aiems:standardIdentifier "IEC 63584-210" ; aiems:standardVersion "2026" ; aiems:standardEdition "Edition 2.0" .
ex:profile-ocpp-21 a aiems:AdapterProfile ;
  aiems:profileIdentifier "ocpp-21-ems-fixture" ; aiems:profileVersion "0.1.0" ;
  aiems:profileSubset "OCPP 2.1 Edition 2 smart charging, status, transaction events and meter values fixture subset; local conformance fixtures, not certification" ;
  aiems:referencesStandard ex:standard-ocpp .
ex:virtual-charger a aiems:VirtualAdapter ;
  aiems:adapterBoundary "EVSE control and feedback" ; aiems:adapterMode "virtual" ;
  aiems:implementsProfile ex:profile-ocpp-21 .
ex:ocpp-scenario-001 a aiems:ConformanceScenario ; aiems:identifier "ocpp-simulated-power-limit-001" ;
  aiems:testsProfile ex:profile-ocpp-21 ;
  aiems:expectedResult "A valid canonical 6 kW limit is encoded, correlated and accepted by the virtual EVSE." ;
  aiems:hasConformanceResult ex:ocpp-result-001 .
ex:ocpp-result-001 a aiems:ConformanceResult ; aiems:conformanceStatus "passed" ;
  aiems:actualResult "Canonical 6 kW intent mapped to the OCPP 2.1 Edition 2 fixture; correlation and acknowledgement matched." ;
  aiems:createdAt "2026-09-30T09:00:02Z"^^xsd:dateTime .

ex:event-001 a aiems:OpenADRSignal ;
  aiems:eventId "event-001" ; aiems:signalType "import-limit-reduction" ;
